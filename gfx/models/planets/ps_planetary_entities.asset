entity = {
	name = "hot_giant_01_section_entity"
	pdxmesh = "planet_clouded_mesh"
	
	meshsettings = {
	name = "planet_geosphereShape"
	texture_diffuse = "hot_giant_01_diffuse.dds"
	texture_normal = "hot_giant_01_normal.dds"
	texture_specular = "brown_dwarf_01_specular.dds"
	shader = PdxMeshPlanetEmissive
	}
	
	##cloud texture override
	meshsettings = {
	name = "clouds_geosphereShape"
	texture_diffuse = "hot_giant_01_clouds_diffuse.dds"
	texture_normal = "nonormal.dds"
	texture_specular = "clouds_medium_specular.dds"
	}
	
	##pole texture override
	meshsettings = {
	name = "polesShape"
	texture_diffuse = "brown_dwarf_poles_01_diffuse.dds"
	texture_normal = "nonormal.dds"
	texture_specular = "nospec.dds"
	}
	
			
	##cloud shadow texture override
	meshsettings = {
	name = "clouds_shadow_geosphereShape"
	texture_diffuse = "hot_giant_01_clouds_shadow_diffuse.dds"
	texture_normal = "nonormal.dds"
	texture_specular = "nospec.dds"
	}
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" time_offset = { 0 100 }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class" } }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class_02" } }
	}
}

